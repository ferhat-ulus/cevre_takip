APP_NAME="Ulus Çevre Takip"
APP_ENV=production
APP_TIMEZONE=Europe/Istanbul
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.ornekalanadiniz.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Doğrudan Nginx/Apache kurulumunda boş bırakın. Ters vekil varsa yalnızca onun IP adresini yazın.
TRUSTED_PROXIES=
